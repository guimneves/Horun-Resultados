# Modelo das variáveis de ambiente do Horun · Resultados EM PRODUÇÃO
# (docker-compose.yml, plugado no Horun Core). Copie para `.env` e preencha —
# o `.env` nunca é versionado (.gitignore). Nenhum valor real entra aqui.

# Senha do PostgreSQL do módulo (o compose monta a URL do banco com ela).
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Limite por arquivo enviado na importação (MB). Um .zip conta pelo tamanho do .zip.
MODULE_MAX_UPLOAD_MB=100

# Backup do banco: pasta FORA do Docker, dias guardados, intervalo.
BACKUP_DIR=C:/HorunBackups/resultados
BACKUP_KEEP_DAYS=30
BACKUP_INTERVAL_HOURS=24

# Avisos (sininho) pelo Horun Core — opcional. O administrador gera a chave em
# Core → Admin → Módulos → Notificações ("gerar chave"). Sem as duas, o módulo
# funciona igual, só sem avisos.
HORUN_CORE_URL=http://horun-core-backend:8000
HORUN_NOTIFY_TOKEN=

# Não há MODULE_SECRET_KEY: o módulo não assina tokens nem tem senha própria
# (o papel vem do cargo no Horun).
